# Create a local .env file from this template. Never commit the real file.
# Use your Alpaca *paper* API keys, not any live-account credentials.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
ALPACA_PAPER=
# Supabase managed authentication and cloud storage. Never expose the service key in browser code.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key
APP_BASE_URL=http://localhost:8502
APP_ENCRYPTION_KEY=generate_with_openssl_rand_base64_32
TWELVE_DATA_API_KEY=replace_with_your_twelve_data_api_key_for_global_screener
